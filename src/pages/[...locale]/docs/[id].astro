---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShutterGuide from '../../../components/ShutterGuide.astro';
import { type Lang } from '../../../i18n/ui';
import { entryLang, entrySlug, localePrefix } from '../../../i18n/utils';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((doc) => {
    const lang = entryLang(doc.id);
    return {
      params: { locale: localePrefix(lang), id: entrySlug(doc.id) },
      props: { doc, lang },
    };
  });
}

const { doc, lang } = Astro.props as { doc: any; lang: Lang };
const { Content } = await render(doc);
---
{doc.data.interactive === 'roller-shutters' ? (
  <BaseLayout title={doc.data.title} description={doc.data.description} lang={lang}>
    <div class="wrap shutter-page">
      <span class="guide-eyebrow">{lang === 'uk' ? 'OSELIA · ІНТЕРАКТИВНА ІНСТРУКЦІЯ' : 'OSELIA · INTERACTIVE GUIDE'}</span>
      <h1>{doc.data.title}</h1>
      <p class="guide-lead">{lang === 'uk' ? 'Пройдіть налаштування в інтерфейсі Home Assistant — від пари реле до кнопки на стіні.' : 'Follow the Home Assistant setup — from a pair of relays to the wall button.'}</p>
      <ShutterGuide lang={lang} />
      <details class="written-guide">
        <summary>{lang === 'uk' ? 'Текстові кроки та усунення несправностей' : 'Written steps and troubleshooting'}</summary>
        <article class="prose"><Content /></article>
      </details>
    </div>
  </BaseLayout>
) : (
  <DocsLayout title={doc.data.title} description={doc.data.description} current={entrySlug(doc.id)} lang={lang}>
    <Content />
  </DocsLayout>
)}
<style>
  .shutter-page { padding-top: 2.5rem; }
  .guide-eyebrow { color: var(--ember-soft); font-size: .75rem; letter-spacing: .08em; font-weight: 700; }
  .shutter-page h1 { margin: .6rem 0; }
  .guide-lead { margin: 0; max-width: 45rem; font-size: 1.1rem; }
  .written-guide { border-top: 1px solid var(--border); padding: 1.3rem 0; }
  .written-guide summary { cursor: pointer; font-weight: 600; }
  .written-guide article { margin: 2rem auto; }
</style>
